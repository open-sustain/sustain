# Maintainer-local working files (rhythmbox/iTunes import scratch space)
/SELF_MIGRATION.md
/iTunes Music Library.xml

# Local clone of the upstream Pioneer/Rhythmbox exporter the analysis
# crate cherry-picks DSP from. Not part of Sustain; kept out of the repo.
/rhythmbox-to-pioneer-xdj-exporter/

# Maintainer-local analysis-validation workspace: large public-corpus
# downloads and extracted audio (e.g. FMA archives behind FMAK), private
# reference collections, curated key/tempo annotations, generated corpus
# manifests, and result JSONs. Multi-gigabyte and/or private — never
# committed. Only aggregate metrics and provenance reach docs/.
/validation-data/

# Analysis-benchmark corpus manifests that reference local audio by
# filesystem path — generated public corpora (e.g. GiantSteps, emitted by
# `analysis-bench adapt-giantsteps`) and private real-audio corpora that may
# name private tracks — are never committed, nor are their results or
# generated fixtures. Only the synthetic recipe and its reproducible
# baseline are tracked.
/crates/analysis_bench/corpora/*.toml
!/crates/analysis_bench/corpora/synthetic.toml
/crates/analysis_bench/baselines/private*.json
/crates/analysis_bench/results/
/crates/analysis_bench/fixtures/

# Flatpak cargo sources are regenerated from Cargo.lock at build time by
# `flatpak-cargo-generator.py`. The file is multi-megabyte generated
# content that must stay in lock-step with Cargo.lock; deriving it at
# build time is cleaner than committing it.
/packaging/flatpak/cargo-sources.json
/.flatpak-builder/
/packaging/flatpak/.flatpak-builder/
/packaging/flatpak/build-dir/
/packaging/flatpak/repo/
/packaging/flatpak/*.flatpak
