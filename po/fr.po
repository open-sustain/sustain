#: crates/ui_gtk/src/sidebar/row_context.rs:500
#, rust-format
msgid ""
"\"{current_name}\" will be deleted along with every playlist, smart "
"playlist, and folder inside it. This cannot be undone."
msgstr ""
"« {current_name} » sera supprimé, ainsi que toutes les listes de lecture, "
"listes intelligentes et dossiers qu’il contient. Cette action est "
"irréversible."

#: crates/ui_gtk/src/sidebar/row_context.rs:512
#, rust-format
msgid ""
"\"{current_name}\" will be removed from the sidebar. The tracks it currently "
"matches stay in your library."
msgstr ""
"« {current_name} » sera retiré de la barre latérale. Les morceaux qui y "
"correspondent actuellement restent dans votre bibliothèque."

#: crates/ui_gtk/src/sidebar/row_context.rs:506
#, rust-format
msgid ""
"\"{current_name}\" will be removed from the sidebar. The tracks themselves "
"stay in your library."
msgstr ""
"« {current_name} » sera retiré de la barre latérale. Les morceaux eux-mêmes "
"restent dans votre bibliothèque."

